#Использовать 1connector

Перем Лог;

Процедура УведомитьОРелизе(Знач ИмяПакета, Знач АдресПроекта, Знач Версия, Знач ПользовательGitHub) Экспорт

	Шаблон = "🔥 %1 опубликовал версию пакета %2 %3
	|Проект: [%4](%5)
	|Автор публикации: [%6](https://github.com/%6)";

	ПредставлениеАдресаПроекта = СтрЗаменить(АдресПроекта, "https://github.com/", "");

	Сообщение = СтрШаблон(
		Шаблон,
		ПользовательGitHub.Имя,
		ИмяПакета,
		Версия,
		ПредставлениеАдресаПроекта,
		АдресПроекта,
		ПользовательGitHub.Логин
	);

	Попытка
		ОтправитьЧерезChatNotifier(Сообщение);
	Исключение
		Лог.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Отправляет уведомление через HTTP-прокси chat-notifier (POST /send с Basic-авторизацией).
// Токен бота Telegram хранится на стороне chat-notifier, хабу он не нужен.
Процедура ОтправитьЧерезChatNotifier(Знач Сообщение)

	ТелоЗапроса = Новый Структура("chat_id, message, format",
		ГлобальныйКонтекст.ИдентификаторГруппыУведомленияВТелеграмм,
		Сообщение,
		"md");

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Аутентификация",
		Новый Структура("Пользователь, Пароль",
			ГлобальныйКонтекст.ЛогинChatNotifier,
			ГлобальныйКонтекст.ТокенChatNotifier));

	Ответ = КоннекторHTTP.Post(ГлобальныйКонтекст.АдресChatNotifier + "/send", , ТелоЗапроса, ДополнительныеПараметры);

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("chat-notifier вернул код %1: %2", Ответ.КодСостояния, Ответ.Текст());
	КонецЕсли;

КонецПроцедуры

Лог = ОбщегоНазначения.ПолучитьЛог();
